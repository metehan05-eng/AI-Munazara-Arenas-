# --- Ortak varsayılan OpenAI uyumlu uç nokta --------------------------------
# NVIDIA Build / NIM, OpenRouter, Ollama, Groq veya llama.cpp kullanılabilir.
BASE_URL=https://integrate.api.nvidia.com/v1
API_KEY=nvapi-BURAYA_ALDIĞIN_KEY_GELECEK

# --- Her ajan için ayrı model (NVIDIA Build Tool-Calling modelleri) ---------
AGENT_A_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
AGENT_B_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# --- İsteğe bağlı: Ajan başına sağlayıcı ayarı ------------------------------
# Boş bırakılan değerler ortak BASE_URL / API_KEY ayarına geri döner.
# İki ajanı ayrı sağlayıcı ve anahtarlarla çalıştırmak için doldurun.
AGENT_A_BASE_URL=
AGENT_A_API_KEY=
AGENT_B_BASE_URL=
AGENT_B_API_KEY=

# --- İsteğe bağlı ayarlar ---------------------------------------------------
TEMPERATURE=0.7
MAX_RESPONSE_TOKENS=1500
MAX_TOOL_ROUNDS=1
PRESENCE_PENALTY=0.3
FREQUENCY_PENALTY=0.4
